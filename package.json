{
    "name": "paper-dreadful",
    "version": "1.0.0",
    "private": true,
    "license": "UNLICENSED",
    "workspaces": [
        "packages/**/*"
    ],
    "scripts": {
        "frontend:build": "yarn workspace frontend build",
        "frontend:start:dev": "yarn workspace frontend start:dev",
        "server:build": "yarn workspace server build",
        "server:start:dev": "yarn workspace server start:dev",
        "build": "concurrently \"yarn:*:build\"",
        "start:dev": "concurrently --kill-others \"yarn:*:start:dev\"",
        "test": "npx vitest run",
        "test:watch": "npx vitest watch",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix"
    },
    "devDependencies": {
        "@stylistic/eslint-plugin": "^2.12.1",
        "@typescript-eslint/eslint-plugin": "^7.0.0",
        "@typescript-eslint/parser": "^7.0.0",
        "buffer": "^5.5.0||^6.0.0",
        "concurrently": "^9.0.0",
        "eslint": "^8.0.0",
        "eslint-plugin-import-newlines": "^1.4.0",
        "eslint-plugin-simple-import-sort": "^12.1.1",
        "process": "^0.11.0",
        "typescript": "^5.0.0",
        "vitest": "^3.2.4"
    },
    "packageManager": "yarn@4.9.2"
}
